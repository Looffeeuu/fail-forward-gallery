# Reference only: the Node service reads process environment variables directly.
# This file is not auto-loaded. Never commit real secrets or personal phone numbers.

NODE_ENV=development
HOST=127.0.0.1
PORT=4173
FFG_SMS_PROVIDER=development

# Optional development overrides:
# FFG_DATA_DIR=/absolute/path/to/development-data
# FFG_DATABASE_PATH=/absolute/path/to/ffg.sqlite
# FFG_DEV_MODERATOR_PHONE=13900139000

# Production must provide a secret of at least 32 characters through the
# deployment platform's secret manager. Production SMS is not connected yet.
# FFG_AUTH_SECRET=
